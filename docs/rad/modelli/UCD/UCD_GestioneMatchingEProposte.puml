@startuml I-Need_UCD_GestioneConvivenzaEFeedback

' ============================================================
'  I-Need - Use Case Diagram del package
'  GestioneConvivenzaEFeedback (RF_GC)
'  Notazione Bruegge & Dutoit: monocromatico, attori stick-figure,
'  use case come ellissi, associazioni come linee semplici,
'  <<include>> (freccia tratteggiata) dallo use case che include
'  verso lo use case incluso.
'  Il Login non e' modellato come <<include>>: l'autenticazione
'  e' parte della entry condition (vedi UC_GC_1 nel RAD).
'  Nomi allineati a UC_GC_1 "Consultazione stato convivenze".
' ============================================================

left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam ranksep 150
skinparam nodesep 90
skinparam defaultFontName "Courier"
skinparam defaultFontStyle bold
skinparam actorStyle default
skinparam packageStyle folder
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam package {
  BackgroundColor white
  BorderColor black
}

' ---------------- Attori ----------------
actor Convivente
actor Operator



package GestioneConvivenzaEFeedback {
  ' RF_GC_1, RF_GC_2
  usecase "ConsultazioneProprieConvivenze"       as UC_ConsProprie

  ' RF_GC_4, RF_GC_5
  usecase "RichiestaInterruzioneConvivenza"      as UC_RichInterr
  ' RF_GC_8, RF_GC_9
  usecase "CompilazioneQuestionarioGradimento"   as UC_CompGrad
  ' RF_GC_3 (UC_GC_1)
  usecase "ConsultazioneStatoConvivenze"         as UC_ConsStato
  ' RF_GC_6
  usecase "VisualizzazioneRichiesteInterruzione" as UC_VisInterr
  ' RF_GC_7
  usecase "RegistrazioneChiusuraAnticipata"      as UC_Chiusura
  ' RF_GC_10
  usecase "ConsultazioneQuestionariGradimento"   as UC_ConsGrad
}

' ---------------- Associazioni attori ----------------
Convivente -- UC_ConsProprie
Convivente -- UC_RichInterr
Convivente -- UC_CompGrad

UC_ConsStato -- Operator
UC_VisInterr -- Operator
UC_Chiusura  -- Operator
UC_ConsGrad  -- Operator


@enduml